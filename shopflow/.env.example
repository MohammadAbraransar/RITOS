# ShopFlow demo store. Copy to shopflow/.env and fill in.

# --- Supabase Postgres (Project Settings > Database > Connection string) ---
# Runtime: transaction pooler (port 6543). Keep pgbouncer=true and schema=shopflow.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=shopflow"
# Schema push/seed: session pooler (port 5432), same schema.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=shopflow"
# Local Postgres alternative (both lines the same):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=shopflow"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=shopflow"

# --- RITOS integration (must match RITOS_API_KEY in backend/.env) ---
RITOS_BASE_URL=http://127.0.0.1:8000
RITOS_API_KEY=ritos_dev_key_secret_2026
# true = decide refunds with the built-in mock instead of RITOS
MOCK_RITOS=false

# --- Store ---
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
SHOPFLOW_BASE_URL=http://127.0.0.1:3000
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
EXECUTION_OWNER=shopflow
MOCK_SETTLE_MS=3000
