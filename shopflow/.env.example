# ShopFlow demo store. `pnpm bootstrap` copies this to shopflow/.env and replaces every __GENERATE__ with a random secret.

# --- Database: Supabase, store tables live in the "shopflow" schema ---
# Write "@" in the password as %40.
# Runtime: transaction pooler (port 6543). Keep pgbouncer=true and schema=shopflow.
DATABASE_URL="postgresql://postgres.rkzcyvnkawtthjxygvei:<db-password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=shopflow"
# Migrations and seed: session pooler (port 5432), same schema.
DIRECT_URL="postgresql://postgres.rkzcyvnkawtthjxygvei:<db-password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=shopflow"

# --- Supabase project (reference; the store talks to Postgres through Prisma) ---
SUPABASE_URL=https://rkzcyvnkawtthjxygvei.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# --- RITOS integration ---
RITOS_BASE_URL=http://127.0.0.1:8000
# Must equal RITOS_API_KEY in backend/.env (bootstrap fills both with the same value)
RITOS_API_KEY=__GENERATE__
# true = decide refunds with the built-in mock instead of RITOS
MOCK_RITOS=false
# How long the store waits for RITOS to adjudicate one claim (ms); RITOS runs all 9 agents synchronously
RITOS_REQUEST_TIMEOUT_MS=30000
# Storefront "test claim" panel for demo orders that are not in the store DB (RITOS must also set DEMO_CLAIMS_ENABLED). Never in production.
DEMO_CLAIMS_ENABLED=false
# RITOS desk console, linked from the storefront
NEXT_PUBLIC_RITOS_CONSOLE_URL=http://127.0.0.1:5173

# Interactive DB transaction limits (ms); Supabase over WAN needs more than Prisma's 5s default
DB_TRANSACTION_TIMEOUT_MS=20000
DB_TRANSACTION_MAX_WAIT_MS=10000

# --- Outbox delivery to RITOS (retries with exponential backoff, then FAILED for an operator to retry) ---
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BASE_BACKOFF_MS=2000
OUTBOX_MAX_BACKOFF_MS=300000

# --- Store ---
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
SHOPFLOW_BASE_URL=http://127.0.0.1:3000
# Encrypts customer login sessions (required, at least 32 characters; there is no fallback)
SESSION_SECRET=__GENERATE__
SESSION_TTL_HOURS=168
# Display currency and locale for the store
NEXT_PUBLIC_STORE_CURRENCY=INR
NEXT_PUBLIC_STORE_LOCALE=en-IN
# Credit time quoted to customers after a refund starts (leave empty to quote none)
REFUND_CREDIT_ESTIMATE=
# Private directory for evidence uploads
UPLOAD_DIR=
EXECUTION_OWNER=shopflow
MOCK_SETTLE_MS=3000
