APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-use
SEED_PASSWORD=ChangeMe123!
DATABASE_URL=sqlite:///./ritos.db
# Supabase (shared project with ShopFlow): use the session pooler (port 5432) and a separate schema.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SCHEMA=ritos
CORS_ORIGINS=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=replace-me-for-local-development

ECOMMERCE_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ShopFlow store integration (RITOS_API_KEY must match shopflow/.env)
SHOPFLOW_BASE_URL=http://127.0.0.1:3000
RITOS_API_KEY=ritos_dev_key_secret_2026
# Orchestrator: CS-1 claims above this amount wait for a human approval
AUTO_APPROVE_MAX_INR=5000
RUN_BACKGROUND_WORKERS=true
