# RITOS API. `pnpm bootstrap` copies this to backend/.env and replaces every __GENERATE__ with a random secret.

APP_ENV=development
# Signs desk-portal login tokens
JWT_SECRET=__GENERATE__
# Password for the seeded development accounts (admin@ritos.local, cs1@ritos.local, ...)
SEED_PASSWORD=ChangeMe123!

# --- Database: Supabase session pooler (port 5432), RITOS tables live in the "ritos" schema ---
# Write "@" in the password as %40. Leave DATABASE_URL as sqlite for a quick local run without Supabase.
DATABASE_URL=postgresql://postgres.rkzcyvnkawtthjxygvei:<db-password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_SCHEMA=ritos
# DATABASE_URL=sqlite:///./ritos.db
# Connection pool (Postgres only). Session mode (5432) caps clients, so keep POOL_SIZE + MAX_OVERFLOW under that cap.
# Transaction mode (port 6543) allows many more clients and is already supported (prepared statements are off).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# A ping per checkout costs one network round-trip; set false on a stable connection to save latency.
DB_POOL_PRE_PING=true

# --- Supabase project (reference; RITOS talks to Postgres directly) ---
SUPABASE_URL=https://rkzcyvnkawtthjxygvei.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# --- Integrations ---
# Shared key between RITOS and the ShopFlow store: must equal RITOS_API_KEY in shopflow/.env
RITOS_API_KEY=__GENERATE__
SHOPFLOW_BASE_URL=http://127.0.0.1:3000
# Secret that other e-commerce servers send in X-Ecommerce-Secret (never put it in browser code)
ECOMMERCE_WEBHOOK_SECRET=__GENERATE__

# --- Orchestrator ---
# CS-1 claims above this amount wait for a human approval instead of auto-approving
AUTO_APPROVE_MAX_INR=5000
# Four-eyes payout roles (comma-separated): proposer, approver and executor must be three different people
PAYOUT_PROPOSER_ROLES=cs_1,finance_approver,refund_operations,administrator
# Claims routed for supervisor approval (above the automatic limit or risk-flagged)
PAYOUT_SUPERVISORY_ROLES=supervisor,finance_approver,administrator
PAYOUT_APPROVER_ROLES=finance_approver,administrator
PAYOUT_EXECUTOR_ROLES=finance_approver,refund_operations,administrator
PAYOUT_RECONCILER_ROLES=finance_approver,administrator,auditor
# Reviewer assignment: roles that receive work in each review queue (the least-loaded person is assigned)
REVIEW_QUEUE_CS2_ROLES=cs_2
REVIEW_QUEUE_CS3_ROLES=cs_3
REVIEW_QUEUE_SUPERVISOR_ROLES=supervisor
RUN_BACKGROUND_WORKERS=true
# Storefront demo claims for orders not in the store DB (RITOS invents their order/transaction). Never in production.
DEMO_CLAIMS_ENABLED=false
# Currency assumed when a claim omits one; accepted currencies
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP
# Risk thresholds (Agent 4): repeat claims in 30 days that count as high velocity, "new account" age, tier cut-offs
RISK_HIGH_VELOCITY_CLAIMS_30D=3
RISK_NEW_ACCOUNT_DAYS=7
RISK_REFUND_RATIO_THRESHOLD=0.5
RISK_REFUND_RATIO_MIN_ORDERS=3
RISK_TIER_HIGH_SCORE=60
RISK_TIER_MEDIUM_SCORE=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only used by the optional Celery worker
REDIS_URL=redis://localhost:6379/0

# --- LLM assist layer (optional; advises only, rules decide; falls back to rules if providers fail) ---
# none | groq | gemini
LLM_PROVIDER=none
LLM_FALLBACK_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT_SECONDS=8
LLM_REDACT_PII=true
